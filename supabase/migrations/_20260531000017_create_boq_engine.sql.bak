-- BOQ Engine: Bill of Quantities tables
-- BOQ is the cost backbone of every project — links WBS, Procurement, IPC, and Budget

-- 1. BOQ Sections — trade/section groupings
create table if not exists public.boq_sections (
  id            uuid primary key default gen_random_uuid(),
  project_id    uuid not null references public.projects(id) on delete cascade,
  section_code  text not null,
  section_name  text not null,
  sort_order    int not null default 0,
  created_at    timestamptz not null default now(),
  updated_at    timestamptz not null default now(),
  unique(project_id, section_code)
);

-- 2. BOQ Items — individual line items
create table if not exists public.boq_items (
  id                uuid primary key default gen_random_uuid(),
  project_id        uuid not null references public.projects(id) on delete cascade,
  section_id        uuid references public.boq_sections(id) on delete set null,
  wbs_node_id       uuid references public.wbs_nodes(id) on delete set null,
  item_no           text not null,
  item_code         text,
  item_description  text not null,
  unit              text not null,
  quantity          numeric(15,2) not null default 0,
  unit_rate         numeric(15,2) not null default 0,
  total             numeric(15,2) generated always as (quantity * unit_rate) stored,
  revision_no       int not null default 0,
  notes             text,
  created_at        timestamptz not null default now(),
  updated_at        timestamptz not null default now(),
  unique(project_id, item_no, revision_no)
);

-- 3. BOQ Revisions — track version changes over the project lifecycle
create table if not exists public.boq_revisions (
  id              uuid primary key default gen_random_uuid(),
  project_id      uuid not null references public.projects(id) on delete cascade,
  revision_no     int not null,
  revision_type   text not null check (revision_type in ('tender', 'contract', 'revised')),
  source          text not null check (source in ('initial', 'variation_order', 're-measurement', 'correction')),
  change_summary  text,
  approved_by     uuid references public.profiles(id) on delete set null,
  approved_at     timestamptz,
  created_at      timestamptz not null default now(),
  unique(project_id, revision_no)
);

-- Enable RLS
alter table public.boq_sections enable row level security;
alter table public.boq_items enable row level security;
alter table public.boq_revisions enable row level security;

-- RLS policies
create policy "Authenticated users can view boq_sections"
  on public.boq_sections for select to authenticated using (true);
create policy "Authenticated users can insert boq_sections"
  on public.boq_sections for insert to authenticated with check (true);
create policy "Authenticated users can update boq_sections"
  on public.boq_sections for update to authenticated using (true);
create policy "Authenticated users can delete boq_sections"
  on public.boq_sections for delete to authenticated using (true);

create policy "Authenticated users can view boq_items"
  on public.boq_items for select to authenticated using (true);
create policy "Authenticated users can insert boq_items"
  on public.boq_items for insert to authenticated with check (true);
create policy "Authenticated users can update boq_items"
  on public.boq_items for update to authenticated using (true);
create policy "Authenticated users can delete boq_items"
  on public.boq_items for delete to authenticated using (true);

create policy "Authenticated users can view boq_revisions"
  on public.boq_revisions for select to authenticated using (true);
create policy "Authenticated users can insert boq_revisions"
  on public.boq_revisions for insert to authenticated with check (true);
create policy "Authenticated users can update boq_revisions"
  on public.boq_revisions for update to authenticated using (true);
create policy "Authenticated users can delete boq_revisions"
  on public.boq_revisions for delete to authenticated using (true);

-- Indexes
create index if not exists idx_boq_sections_project on boq_sections(project_id);
create index if not exists idx_boq_items_project on boq_items(project_id);
create index if not exists idx_boq_items_section on boq_items(section_id);
create index if not exists idx_boq_items_wbs on boq_items(wbs_node_id);
create index if not exists idx_boq_revisions_project on boq_revisions(project_id);

-- Updated-at triggers
create or replace function boq_updated_at()
returns trigger as $$
begin
  new.updated_at = now();
  return new;
end;
$$ language plpgsql;

create trigger trg_boq_sections_updated_at
  before update on boq_sections for each row execute function boq_updated_at();
create trigger trg_boq_items_updated_at
  before update on boq_items for each row execute function boq_updated_at();
