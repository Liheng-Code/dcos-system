# Supabase — required
# Get these from your Supabase project dashboard (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local development only: show features whose manifest status is "development" without
# switching each one on in Module Settings. Leave unset in production.
# NEXT_PUBLIC_DCOS_SHOW_DEV_FEATURES=true

# Telegram bot (@dcos_Attendance_bot) — required for Telegram attendance check-in
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Any strong random string; also passed to setWebhook as secret_token and compared against X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
# Daily Reporting bot (@DCOSSiteReport_Bot) — a separate bot from the attendance bot above.
# Its webhook is /api/dr/telegram/webhook, registered for "message" and "my_chat_member" updates.
TELEGRAM_DR_BOT_TOKEN=your-daily-reporting-bot-token
TELEGRAM_DR_WEBHOOK_SECRET=your-daily-reporting-webhook-secret
# Shown in the "Link Telegram" hint and used for the one-tap link (no @)
NEXT_PUBLIC_TELEGRAM_DR_BOT_USERNAME=DCOSSiteReport_Bot
# Direct link of the Mini App registered with BotFather (URL: <app>/dr-miniapp), no query string.
# Without it the bot cannot post the Submit Daily Report button.
TELEGRAM_DR_MINIAPP_LINK=https://t.me/DCOSSiteReport_Bot/report
# Optional; if unset the Mini App session secret is derived from TELEGRAM_DR_BOT_TOKEN
DR_MINIAPP_SESSION_SECRET=
# Base URL of the deployed Telegram Mini App route group (no trailing slash), e.g. https://dcos-system-web.vercel.app/telegram-app
# Used to build web_app inline-keyboard buttons on bot replies (e.g. /apply, /balance, /pending). Button is skipped if unset.
TELEGRAM_MINIAPP_BASE_URL=https://your-app.example.com/telegram-app

# AI BOQ drafting (Quantity Surveying > Tender BOQ > AI Draft from Drawing). Server-only; never NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Deploy-time module selection (set on Vercel before deploying; leave unset locally to show everything).
# Comma-separated module_settings keys; project and administration are always on.
# DCOS_ENABLED_MODULES=project

# Quick Demo Access on the login page. OFF unless both are set. NEXT_PUBLIC_ values are
# visible in the browser: only enable on local dev or a separate demo deployment whose
# demo users are non-admin and hold no real data. Never set on production.
# NEXT_PUBLIC_DCOS_DEMO_LOGIN=true
# NEXT_PUBLIC_DCOS_DEMO_PASSWORD=
