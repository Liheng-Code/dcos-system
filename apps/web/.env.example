# Supabase — required
# Get these from your Supabase project dashboard (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram bot (@dcos_Attendance_bot) — required for Telegram attendance check-in
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Any strong random string; also passed to setWebhook as secret_token and compared against X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
# Base URL of the deployed Telegram Mini App route group (no trailing slash), e.g. https://dcos-system-web.vercel.app/telegram-app
# Used to build web_app inline-keyboard buttons on bot replies (e.g. /apply, /balance, /pending). Button is skipped if unset.
TELEGRAM_MINIAPP_BASE_URL=https://your-app.example.com/telegram-app
