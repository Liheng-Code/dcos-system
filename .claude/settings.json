{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "PowerShell|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-db-wipe.ps1"],
            "timeout": 15,
            "statusMessage": "Checking for DB-wipe commands"
          }
        ]
      }
    ]
  }
}
